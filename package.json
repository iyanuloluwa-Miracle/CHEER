{
  "name": "cheer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TippyMe — creator support platform for African builders",
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env server/db/seed.ts",
    "start:prod:migrate": "drizzle-kit migrate && node .output/server/index.mjs"
  },
  "dependencies": {
    "@byteship/js": "^0.1.5",
    "@neondatabase/serverless": "^1.1.0",
    "@paralleldrive/cuid2": "^2.2.2",
    "@pinia/nuxt": "^0.11.2",
    "bcryptjs": "^3.0.3",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.44.5",
    "jose": "^6.2.12",
    "nuxt": "^3.21.11",
    "pinia": "^3.0.3",
    "resend": "^6.28.0",
    "vue": "^3.5.40",
    "vue-router": "^4.5.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.9.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/decimal.js": "^1.0.2",
    "@types/ws": "^8.18.1",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.18.0",
    "get-port-please": "^3.1.2",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.2.10"
  },
  "engines": {
    "node": ">=20"
  }
}
