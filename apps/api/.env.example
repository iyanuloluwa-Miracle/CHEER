NODE_ENV=development
PORT=3001
API_PREFIX=api
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# Placeholder secrets for local foundation — replace before real auth/payments
# Production refuses to boot with these placeholders (AUTH_SECRET / OTP_HASH_PEPPER
# must be ≥32 chars, distinct, and non-placeholder). Production also requires
# BACHS_API_KEY, BACHS_WEBHOOK_SECRET, SENDBYTE_API_KEY, https APP_URL, and https API_URL.
AUTH_SECRET=dev-only-change-me
OTP_HASH_PEPPER=dev-only-change-me

DATABASE_URL=postgresql://cheer:cheer@localhost:5432/cheer?schema=public&connect_timeout=5

# Sandbox for local/dev. Production: live key + https://api.bachs.io (or current Bachs live base).
BACHS_API_KEY=
BACHS_API_BASE_URL=https://sandbox-api.bachs.io
BACHS_WEBHOOK_SECRET=

SENDBYTE_API_KEY=
SENDBYTE_WEBHOOK_SECRET=
SENDBYTE_FROM_EMAIL=TippyMe <noreply@example.com>

# Observability (optional)
LOG_FORMAT=text
# ERROR_MONITORING_DSN=
