# Leave empty so the browser calls same-origin /api (Nuxt proxies to Nest).
# Production recommendation: keep empty and terminate TLS at the edge with
#   /api → Nest, / → Nuxt  (session cookie stays first-party).
# Never put SENDBYTE_*, BACHS_*, DATABASE_URL, or AUTH_* in this file.
NUXT_PUBLIC_API_URL=
NUXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only / Nitro proxy target (also set as API_INTERNAL_URL in Docker).
NUXT_PUBLIC_API_PROXY_TARGET=http://localhost:3001
# API_INTERNAL_URL=http://api:3001
