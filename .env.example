# TippyMe — environment variable placeholders
# Copy to `.env` in this directory (single Nuxt/Nitro process).
# Never commit real secrets.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
# Same origin as APP_URL — Bachs webhooks hit /api/webhooks/bachs
API_URL=http://localhost:3000
AUTH_SECRET=change-me-to-a-long-random-string
OTP_HASH_PEPPER=change-me-to-a-long-random-string
LOG_FORMAT=text
# ERROR_MONITORING_DSN=

# -----------------------------------------------------------------------------
# Database (Prisma / PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://cheer:cheer@localhost:5432/cheer?schema=public&connect_timeout=5

# -----------------------------------------------------------------------------
# Bachs — payments (Nitro server only — never NUXT_PUBLIC_*)
# Official docs use BACHS_API_KEY:
#   https://docs.bachs.io/api-reference/api-standards.md
# Production webhook URL (no OutRay):
#   https://<production-domain>/api/webhooks/bachs
# -----------------------------------------------------------------------------
BACHS_API_KEY=sk_sandbox_35f3d305_ff1nE-RS9UUAPT9FHrk4m4fuZUpy1_WiEj0W6GqZmQQ
BACHS_API_BASE_URL=https://sandbox-api.bachs.io
BACHS_WEBHOOK_SECRET=whsec_370a02334b6323167f44ca27bb8e827c0c0d06446509cfb4ee1754b89c77e323

# -----------------------------------------------------------------------------
# SendByte — email (Nitro server only — never NUXT_PUBLIC_*)
# -----------------------------------------------------------------------------
SENDBYTE_API_KEY=
SENDBYTE_WEBHOOK_SECRET=
SENDBYTE_FROM_EMAIL=TippyMe <noreply@example.com>

# -----------------------------------------------------------------------------
# Redis — optional (required before multi-instance rate limits)
# -----------------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Nuxt public (safe for browser)
# -----------------------------------------------------------------------------
NUXT_PUBLIC_API_URL=
NUXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# OutRay — CLI only (development webhooks). Not used in production.
# -----------------------------------------------------------------------------
# OUTRAY_PUBLIC_URL=https://cheer.tunnel.outray.app
