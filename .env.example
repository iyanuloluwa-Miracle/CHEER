# TippyMe — environment variable placeholders
# Copy to `.env` in this directory (single Nuxt/Nitro process).
# Never commit real secrets.

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
# Same origin as APP_URL — Bachs webhooks hit /api/webhooks/bachs
API_URL=http://localhost:3000
AUTH_SECRET=change-me-to-a-long-random-string
OTP_HASH_PEPPER=change-me-to-a-long-random-string
LOG_FORMAT=text
# ERROR_MONITORING_DSN=

# -----------------------------------------------------------------------------
# Database (Prisma / PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://cheer:cheer@localhost:5432/cheer?schema=public&connect_timeout=5

# -----------------------------------------------------------------------------
# Bachs — payments (Nitro server only — never NUXT_PUBLIC_*)
# Official docs use BACHS_API_KEY:
#   https://docs.bachs.io/api-reference/api-standards.md
# Production webhook URL (no OutRay):
#   https://<production-domain>/api/webhooks/bachs
# -----------------------------------------------------------------------------
BACHS_API_KEY=
BACHS_API_BASE_URL=https://sandbox-api.bachs.io
BACHS_WEBHOOK_SECRET=
# Platform fee percent on destination charges (Connect settlement). Default 5.
BACHS_PLATFORM_FEE_PERCENT=5

# -----------------------------------------------------------------------------
# Cencori — AI assist (Nitro server only — never NUXT_PUBLIC_*)
# OpenAI-compatible: https://api.cencori.com/v1
# Leave empty to use local fallback copy for bio / thank-you.
# -----------------------------------------------------------------------------
CENCORI_API_KEY=
CENCORI_API_BASE_URL=https://api.cencori.com/v1
CENCORI_MODEL=gpt-4o-mini

# -----------------------------------------------------------------------------
# SendByte — email (Nitro server only — never NUXT_PUBLIC_*)
# -----------------------------------------------------------------------------
SENDBYTE_API_KEY=
SENDBYTE_WEBHOOK_SECRET=
SENDBYTE_FROM_EMAIL=TippyMe <noreply@example.com>

# -----------------------------------------------------------------------------
# Byteship — profile photo uploads (Nitro server only — never NUXT_PUBLIC_*)
# https://byteship.dev/docs/browser-uploads
# -----------------------------------------------------------------------------
BYTESHIP_API_KEY=

# -----------------------------------------------------------------------------
# Redis — optional (required before multi-instance rate limits)
# -----------------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Nuxt public (safe for browser)
# -----------------------------------------------------------------------------
NUXT_PUBLIC_API_URL=
NUXT_PUBLIC_APP_URL=http://localhost:3000

# Sabilytics — site analytics (https://www.sabilytics.com/). Leave empty to disable.
# Copy site ID, domain (hostname only), and script src from the Sabilytics install snippet.
NUXT_PUBLIC_SABILYTICS_SITE_ID=
NUXT_PUBLIC_SABILYTICS_DOMAIN=
NUXT_PUBLIC_SABILYTICS_SCRIPT_URL=

# -----------------------------------------------------------------------------
# OutRay — CLI only (development webhooks). Not used in production.
# -----------------------------------------------------------------------------
# OUTRAY_PUBLIC_URL=https://cheer.tunnel.outray.app
