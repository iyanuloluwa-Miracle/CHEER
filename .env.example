# TippyMe — environment variable placeholders
# Copy values into apps/api/.env and apps/web/.env as needed.
# Never commit real secrets.

# -----------------------------------------------------------------------------
# Application (TippyMe-chosen)
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3001
API_PREFIX=api
APP_URL=http://localhost:3000
API_URL=http://localhost:3001
AUTH_SECRET=change-me-to-a-long-random-string
OTP_HASH_PEPPER=change-me-to-a-long-random-string

# -----------------------------------------------------------------------------
# Database (Prisma / PostgreSQL) — Phase 3
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://cheer:cheer@localhost:5432/cheer?schema=public&connect_timeout=5

# -----------------------------------------------------------------------------
# Bachs — payments (NestJS only)
# Official docs use BACHS_API_KEY:
#   https://docs.bachs.io/api-reference/api-standards.md
# -----------------------------------------------------------------------------
BACHS_API_KEY=
BACHS_API_BASE_URL=https://sandbox-api.bachs.io
BACHS_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# SendByte — email (NestJS only)
# Official docs use SENDBYTE_API_KEY / SENDBYTE_WEBHOOK_SECRET
# -----------------------------------------------------------------------------
SENDBYTE_API_KEY=
SENDBYTE_WEBHOOK_SECRET=
SENDBYTE_FROM_EMAIL=TippyMe <noreply@example.com>

# -----------------------------------------------------------------------------
# Redis — optional
# -----------------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Nuxt public (safe for browser) — apps/web/.env
# -----------------------------------------------------------------------------
NUXT_PUBLIC_API_URL=http://localhost:3001
NUXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# OutRay — CLI only (development webhooks). Not used by NestJS runtime.
# -----------------------------------------------------------------------------
# OUTRAY_PUBLIC_URL=https://cheer-api.tunnel.outray.app
